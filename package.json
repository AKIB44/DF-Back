{
  "name": "dentaflow-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-db.js",
    "db:fresh": "node scripts/reset-db.js && node seeds/seed.js",
    "db:sync": "node scripts/sync-from-source.js",
    "db:provision": "node scripts/provision-db.js",
    "seed": "node seeds/seed.js",
    "seed:rx": "node seeds/rxMasterSeed.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
  }
}
